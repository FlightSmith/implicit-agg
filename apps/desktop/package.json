{
  "name": "aircraft-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "core:wasm": "wasm-pack build ../../crates/aircraft-wasm --target web --out-dir ../../apps/desktop/src/wasm-core --release",
    "dev": "npm run core:wasm && vite",
